<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gempba</groupId>
        <artifactId>gempba-dashboard</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>adapters</artifactId>

    <name>GemPBA Dashboard :: Adapters</name>
    <description>
        Driven/driving adapters: the wire protocol DTOs + Jackson, the telemetry
        client, the SSH tunnel IO, the connection controller, and the
        protocol→WorldSnapshot mapper/store. Depends on core; uses Jackson; must
        NOT depend on SWT — that is what lets the connection controller live
        here, marshaling UI callbacks through the core UiExecutor port.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.gempba</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
        </dependency>
    </dependencies>
</project>
