<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.gempba</groupId>
        <artifactId>gempba-dashboard</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>app</artifactId>

    <name>GemPBA Dashboard :: App</name>
    <description>
        The composition root: Main, the DashboardApp wiring, the SWT UiExecutor,
        the frame-coalescer, the DashboardCoordinator, and the app
        icons. The only module that depends on everything (core, adapters, ui)
        plus SWT, and the only one that constructs concrete instances and wires
        the ports to their implementations.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.gempba</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.gempba</groupId>
            <artifactId>adapters</artifactId>
        </dependency>
        <dependency>
            <groupId>io.gempba</groupId>
            <artifactId>ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>${swt.artifactId}</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                            <!-- Stamps Implementation-Version into the manifest so the About dialog
                                 shows the release version (it falls back to "dev" without it). -->
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
