{
  "name": "@gempba/updater",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "GemPBA Dashboard updates: checks the public repository's GitHub Releases at startup and from Help, and installs a newer version on the user's click.",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "electronMain": "lib/electron-main/updater-electron-main-module"
    },
    {
      "frontendElectron": "lib/electron-browser/updater-frontend-module"
    }
  ],
  "dependencies": {
    "@theia/core": "1.76.0",
    "electron-updater": "^6.8.11",
    "tslib": "^2.8.1"
  },
  "scripts": {
    "clean": "rimraf lib *.tsbuildinfo",
    "compile": "tsc -b",
    "test": "mocha \"lib/**/*.spec.js\""
  }
}
