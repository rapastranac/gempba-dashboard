    "@theia/ai-core": "1.76.0",
    "@theia/ai-mcp": "1.76.0",
    "@theia/core": "1.76.0",
    "@theia/debug": "1.76.0",
    "@theia/file-search": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/notebook": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/scm": "1.76.0",
    "@theia/task": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/vsx-registry": "1.76.0",
