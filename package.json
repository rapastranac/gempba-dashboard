{
  "private": true,
  "name": "gempba-dashboard",
  "version": "2.0.0",
  "license": "MIT",
  "description": "GemPBA Dashboard — Eclipse Theia Electron app (TypeScript)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "theia/*"
  ],
  "scripts": {
    "clean": "rimraf \"theia/*/lib\" \"theia/*/*.tsbuildinfo\" && npm --workspace @gempba/electron-app run clean",
    "compile": "tsc -b",
    "lint": "eslint .",
    "build": "npm run compile && npm --workspace @gempba/electron-app run build",
    "package": "npm run compile && npm run rebuild:electron && npm --workspace @gempba/electron-app run package",
    "rebuild:electron": "npm --workspace @gempba/electron-app run rebuild",
    "start": "npm --workspace @gempba/electron-app run start",
    "watch": "npm --workspace @gempba/electron-app run watch",
    "test": "node configs/check-layers.js && npm run lint && mocha \"configs/*.spec.js\" && npm run compile && npm run test --workspaces --if-present",
    "mock": "npm run mock -w @gempba/telemetry --"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@theia/ffmpeg": true,
    "@vscode/windows-ca-certs": true,
    "cpu-features": false,
    "drivelist": true,
    "electron-winstaller": false,
    "esbuild": true,
    "keytar": true,
    "msgpackr-extract": true,
    "native-keymap": true,
    "node-pty": true,
    "puppeteer": false,
    "ssh2": false
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chai": "^4.5.0",
    "eslint": "^10.12.0",
    "mocha": "^10.8.2",
    "rimraf": "^5.0.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
